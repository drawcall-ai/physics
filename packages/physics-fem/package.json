{
  "name": "@drawcall/physics-fem",
  "version": "0.1.0",
  "type": "module",
  "description": "Prepare cached reduced FEM soft bodies from Three.js assets.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/assets.mjs && node scripts/embed.mjs && rm -rf dist && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --dir test && node --test test/prepare.mjs",
    "build:gmsh": "node scripts/gmsh.mjs"
  },
  "dependencies": {
    "@drawcall/glts": "4.0.0",
    "vitecache": "0.2.1",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@drawcall/physics": "^0.1.0",
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@drawcall/physics": "workspace:*",
    "@types/node": "^24.13.6",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "pyodide": "314.0.7",
    "three-mesh-bvh": "0.9.16",
    "vite": "8.2.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/physics.git",
    "directory": "packages/physics-fem"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
