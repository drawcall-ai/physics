{
  "name": "@drawcall/physics",
  "version": "0.1.0",
  "type": "module",
  "description": "Physics scene objects, automatic colliders, and joints for Three.js.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "generated/coacd"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build:coacd": "bash scripts/build-coacd.sh"
  },
  "peerDependencies": {
    "three": ">=0.177.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/physics.git",
    "directory": "packages/physics"
  },
  "homepage": "https://github.com/drawcall-ai/physics#readme",
  "bugs": {
    "url": "https://github.com/drawcall-ai/physics/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.6"
  }
}
